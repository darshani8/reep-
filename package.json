{
  "name": "reep-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "BGSCET MBA — REEP Tracking Dashboard: student journey, time usage, faculty mentor focus tracking, cohort analytics and AI resume builder",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "roster": "tsx scripts/erp-import.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force --skip-seed && npm run db:seed",
    "setup": "npm run db:up && node scripts/wait-for-db.mjs && prisma migrate deploy && npm run db:seed",
    "ai:setup": "ollama pull gemma3:12b && ollama create reep-gemma3 -f ollama/reep-gemma3.Modelfile",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@google/genai": "^2.17.1",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@mui/material-nextjs": "^9.1.1",
    "@mui/x-charts": "^9.10.1",
    "@mui/x-data-grid": "^9.10.1",
    "@prisma/client": "6.19.3",
    "exceljs": "^4.4.0",
    "jose": "^6.2.8",
    "mammoth": "^1.12.1",
    "next": "16.3.0",
    "nodemailer": "^9.0.5",
    "pdf-parse": "^2.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "prisma": "6.19.3",
    "tsx": "^4.23.5",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  }
}
