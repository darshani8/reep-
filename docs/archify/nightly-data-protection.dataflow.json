  "cards": [
    {
      "dot": "rose",
      "title": "Which copy outlives what",
      "items": [
        "Snapshots + Singapore copy: 35 days",
        "Monthly DB-only snapshot: 365 days"
      ]
    },
    {
      "dot": "violet",
      "title": "Write, never read",
      "items": [
        "PutObject only; no GetObject, Delete",
        "Existence via ListBucket, not Head"
      ]
    },
    {
      "dot": "amber",
      "title": "Order of the night (IST)",
      "items": [
        "Every copy runs before 03:00",
        "03:00 sweep spares users, students"
      ]
