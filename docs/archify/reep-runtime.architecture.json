  "cards": [
    {
      "dot": "cyan",
      "title": "Edge and network",
      "items": [
        "WAF: AWS common and bad-inputs rules, 2000-request IP rate limit",
        "SizeRestrictions_BODY is counted, so uploads reach the API"
      ]
    },
    {
      "dot": "rose",
      "title": "Student-data egress gate",
      "items": [
        "Off-machine models need LLM_ALLOW_REMOTE_STUDENT_DATA=true",
        "reep-core sets it, so production opens the gate to Bedrock"
      ]
    },
    {
      "dot": "emerald",
      "title": "Nightly protection",
      "items": [
        "IST: 23:30 ledger, 01:00 pg_dump, 02:00 files, 03:00 retention",
        "Object-Locked buckets: tasks write and list, never read"
      ]
    }
  ]
