# apps/interview-realtime/.env.example
#
# Copy this file to `.env` IN THIS SAME DIRECTORY, fill in OPENAI_API_KEY, and
# never commit the copy:
#
#     Windows (PowerShell):  Copy-Item .env.example .env
#     POSIX (bash/zsh):      cp .env.example .env
#
# TWO env files are read, lowest precedence first (app/config.py):
#
#     1. apps/api-py/.env   - the shared file the API and the LiveKit voice
#                             worker already read, so an OPENAI_API_KEY entered
#                             once is picked up here without being copied.
#     2. apps/interview-realtime/.env - this app's own file. Read SECOND, so it
#                             WINS on any key both files set.
#
# Neither file is required; a missing one is ignored. Names map case-insensitively
# onto the snake_case fields of app/config.py::Settings (OPENAI_API_KEY ->
# openai_api_key), every string field defaults to "" so a blank or absent line is
# legal, and keys this app does not declare are ignored rather than rejected -
# which is what lets it share apps/api-py/.env with three other processes.


# ---------------------------------------------------------------------------
# OpenAI Realtime - the only secret in this app
# ---------------------------------------------------------------------------

# Used on exactly ONE socket: the relay's outbound connection to api.openai.com,
# as an `Authorization: Bearer <key>` header. It is never sent downstream to the
# browser, never echoed inside an error the browser can see, and never written to
# a log line. That containment is the entire reason this relay exists instead of
# the browser talking to OpenAI directly.
#
# Blank -> the process still boots, still serves /health and the bundled client,
# and logs one WARNING naming both env-file paths it searched; /ws/interview then
# accepts the browser socket and immediately closes it with 4001 "Voice service
# not configured". Nothing else in the app is affected.
OPENAI_API_KEY=

# Model id placed in the upstream query string: ?model=<this>. It is
# percent-encoded exactly once, in Settings.realtime_url, so a stray character
# becomes a clean 404 rather than a malformed URL.
#
# Default, and what a blank or whitespace-only value resolves to: gpt-realtime
# A name that does not exist fails the HANDSHAKE with HTTP 404; a model your
# organisation is not entitled to fails it with 403. Both surface to the student
# as close 4002 and to the operator as an ERROR log carrying the status code.
# Do NOT guess a dated snapshot id - list your account's models first. See
# README > Troubleshooting > "Wrong model name".
OPENAI_REALTIME_MODEL=gpt-realtime


# ---------------------------------------------------------------------------
# Serving
# ---------------------------------------------------------------------------

# TCP port for this service. 8080 is the app default and deliberately avoids
# every port the rest of the stack owns: 3300 (FastAPI API), 4200 (Angular dev
# server), 5433 (Postgres). Blank -> 8080.
#
# NOTE: uvicorn's own --port flag WINS over this value, because uvicorn binds the
# socket before the app is imported. The README's run command therefore passes
# --port explicitly; keep the two in step, or a change here will look ignored.
PORT=8080

# Browser origin(s) allowed to open the interview WebSocket, comma-separated, no
# trailing slash. This is the CSRF boundary for a WebSocket: browsers do NOT
# apply the same-origin policy to WS handshakes, they only attach an `Origin`
# header, and CORS middleware never sees a socket upgrade. Without this check any
# page on the internet can open a billed interview session against your key.
#
# The bundled client (public/index.html, served by this same process) is
# same-origin and works regardless, on whatever host:port you reached it on: the
# relay compares the Origin against its own Host header before consulting this
# list. Add the Angular dev server here when driving the relay from apps/web.
#
# Blank -> same-origin ONLY, and that is now literally true. It previously meant
# "allow every origin", i.e. blank was the widest setting rather than the
# narrowest, and any page on the internet could open a billed session.
WEB_ORIGIN=http://localhost:4200


# ---------------------------------------------------------------------------
# Guardrails - see README > Guardrails for the close codes these produce
# ---------------------------------------------------------------------------

# Hard cap on total session wall-clock, in seconds. This is the COST ceiling as
# much as a UX one: audio tokens bill per second of a session that a forgotten
# browser tab would otherwise hold open indefinitely. 900 = 15 minutes, longer
# than any mock-interview round and below OpenAI's own session limit, so ours
# binds first and the student always gets our readable reason instead of an
# unexplained upstream hang-up.
# Fires -> both sockets close, code 4009 "Session limit of 15 minutes reached".
SESSION_MAX_SECONDS=900

# Cap on time with NO inbound audio FRAMES from the browser, in seconds.
#
# Read that literally: the client's worklet emits ~25 frames/s whether or not
# anyone is speaking, so this does NOT catch a student who walked away from a
# healthy tab — it catches a dead socket, a suspended/backgrounded tab (mobile
# browsers stop mic capture), a revoked or dead microphone, and a client that
# never started sending. Silence in the room is the model's problem, not this
# timer's. 120 = 2 minutes: long enough to survive a network reconnect, short
# enough that a wedged session is not billed for the full session cap.
# Fires -> both sockets close, code 4008 "No audio received for 2 minutes".
IDLE_MAX_SECONDS=120

# PER-WORKER concurrent-session ceiling, enforced by one asyncio.Semaphore. N
# uvicorn workers give N times this number, so set the honest per-process figure
# and scale out - one CPython process cannot carry the 1000-student target
# (~96 MB/s of PCM and ~25k base64 encodes/s). Exhausted -> close 1013 "Too many
# interviews in progress", rather than queueing students behind a full house.
# Blank -> 100.
MAX_CONCURRENT_SESSIONS=100


# ---------------------------------------------------------------------------
# Optional overrides - every key below is declared in app/config.py and may be
# left commented out. Uncomment only when you mean to change the default.
# ---------------------------------------------------------------------------

# Interface to bind. 127.0.0.1 keeps the relay off the LAN, which is right for a
# laptop; a container or a shared dev box needs 0.0.0.0 - and if you set that,
# set WEB_ORIGIN too, because the relay is then reachable by other machines.
# HOST=127.0.0.1

# Upstream base URL, without the query string. Overridden only to point at a
# proxy or a recorded fixture; the model is appended by Settings.realtime_url.
# OPENAI_REALTIME_BASE_URL=wss://api.openai.com/v1/realtime

# Model voice. Frozen for the whole session once the model has emitted its first
# audio, so it is sent in the single session.update and never changed. "alloy"
# exists on both API generations; newer names are GA-only, and an unknown name is
# answered with an `error` event that does NOT close the socket - the session
# then runs on the default voice SILENTLY. Verify before changing.
# OPENAI_REALTIME_VOICE=alloy

# Non-empty pins the older BETA event surface (the only valid value is
# "realtime=v1"), which emits response.audio.delta and expects a FLAT session
# object. Blank selects GA (response.output_audio.delta, nested session.audio.*).
# The relay normalises both event vocabularies, so this only decides which the
# API sends: it is the lever for the day one generation is retired, not a knob to
# turn casually. See README > Troubleshooting > "Connects, transcribes, no sound".
# OPENAI_REALTIME_BETA_HEADER=

# Server-VAD tuning. Settings rather than literals because these are the numbers
# a real deployment retunes against real rooms, and needing a redeploy to change
# a float is how tuning stops happening.
#   VAD_THRESHOLD            0.0-1.0 activation energy. 0.5 suits a nervous
#                            candidate in a hostel room with a ceiling fan. Raise
#                            toward 0.6 only if VAD self-triggers on noise;
#                            lowering it lets room noise start a turn.
#   VAD_PREFIX_PADDING_MS    Audio retained BEFORE detected speech onset. Below
#                            ~200 ms candidates lose the leading consonant of
#                            "Actually...".
#   VAD_SILENCE_DURATION_MS  Silence before the turn is considered over.
#                            Deliberately above the API's 500 ms default: the
#                            persona promises not to interrupt the student, and a
#                            real answer contains 400-600 ms thinking pauses
#                            mid-sentence. 700 is the smallest value that
#                            reliably does not cut a candidate off.
# VAD_THRESHOLD=0.5
# VAD_PREFIX_PADDING_MS=300
# VAD_SILENCE_DURATION_MS=700

# Root logger level for this process. DEBUG logs every event type the relay does
# not forward, once each - useful when settling which API generation you are on,
# noisy otherwise. Safe to set: app/server.py clamps the `websockets` logger to
# INFO no matter what goes here, because at DEBUG that library prints the
# outbound handshake header by header - including
# `Authorization: Bearer <OPENAI_API_KEY>` - with no redaction.
# LOG_LEVEL=INFO

# "prod" tightens one behaviour: a WebSocket handshake with NO Origin header
# (curl, a smoke test) is allowed in dev and refused in prod, where the only
# legitimate clients are browsers.
# ENV=dev
