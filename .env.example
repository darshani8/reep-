DATABASE_URL="postgresql://reep:reep_dev_password@localhost:5433/reep_dev?schema=public"
AUTH_SECRET="generate-a-long-random-string"

# --- Resume writer -----------------------------------------------------------
# Any OpenAI-compatible /v1/chat/completions server. Set both BASE_URL and MODEL
# to turn it on; leave either blank and the app falls back to Anthropic, then to
# the deterministic composer. This path is preferred when configured, because the
# prompt carries student PII and a local model keeps it on the machine.
#
# Local (default — run `npm run ai:setup` once to build the model):
LLM_BASE_URL="http://127.0.0.1:11434/v1"
LLM_MODEL="reep-gemma3"
LLM_API_KEY=""
# Must match the server's actual context window — see ollama/reep-gemma3.Modelfile.
LLM_CONTEXT_TOKENS="16384"
LLM_TIMEOUT_MS="300000"
#
# Other servers that speak the same protocol — swap the three values above:
#   LM Studio     LLM_BASE_URL="http://127.0.0.1:1234/v1"
#   vLLM          LLM_BASE_URL="http://your-host:8000/v1"
#   OpenRouter    LLM_BASE_URL="https://openrouter.ai/api/v1"          + a key
#   Groq          LLM_BASE_URL="https://api.groq.com/openai/v1"        + a key
#   Gemini        LLM_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
#
# Google Gemini (free tier) — full example. "Gemini" is Google's *proprietary*
# model with a free API quota; the open-source Google model is Gemma, which is
# what `reep-gemma3` above already runs locally. To use free Gemini instead:
#   LLM_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
#   LLM_MODEL="gemini-2.5-flash"          # or gemini-2.0-flash; free-tier models
#   LLM_API_KEY="<key from aistudio.google.com/app/apikey>"   # free
#   LLM_CONTEXT_TOKENS="1000000"          # Gemini Flash has a very large window
# CAUTION for a student-data product: this endpoint is NOT loopback, so the
# resume writer (name, USN, marks, attendance) is REFUSED by the egress gate
# unless LLM_ALLOW_REMOTE_STUDENT_DATA="true" below. And Google's FREE tier may
# use submitted content to improve its products — unlike the paid tier — so
# routing student PII through it is a DPDP-Act exposure and undoes REEP's
# privacy edge. Recommended: keep local Gemma for the resume, and only point
# Gemini at PUBLIC-data tasks (a job posting is exempt from the gate).
# Anything off this machine sends the student's record to a third party — and
# REEP now enforces that rather than only warning about it. If LLM_BASE_URL is
# not a loopback address, the resume writer refuses to send the student's name,
# USN, marks and attendance and composes the draft deterministically instead;
# the screen says so. Set this to exactly "true" to permit it anyway.
#
# This governs ANTHROPIC_API_KEY too. api.anthropic.com is not this machine, so
# the key on its own no longer turns the Anthropic path on: it names the
# recipient, it does not consent on the student's behalf. Without this flag a
# key-only setup gets the deterministic draft and the banner that explains why.
LLM_ALLOW_REMOTE_STUDENT_DATA=""

# Optional second path, used only when LLM_BASE_URL is unset — and, like any
# other off-machine writer, only when LLM_ALLOW_REMOTE_STUDENT_DATA is "true".
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

COURSERA_CLIENT_ID=""
COURSERA_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Gemini general/public assistant (native @google/genai SDK — server-side only)
# ---------------------------------------------------------------------------
# SEPARATE from the LLM_BASE_URL resume writer above, and from /api/agent. This
# powers src/lib/ai/gemini-assistant.ts (general everyday + campus-water modes)
# and talks to Google directly via the native SDK (needed for Google Search
# grounding, which the OpenAI-compat endpoint does not expose for text).
#
# GENERAL/PUBLIC DATA ONLY. This path is intentionally NOT behind the egress
# gate, so it must never receive student records. The student-data assistant
# (/api/agent) stays on the gated LLM_* path above. Free Gemini is fine here
# because no PII is involved; do not route marks/attendance/USN through it.

# Required for the assistant. Your Gemini API key from
# https://aistudio.google.com/apikey — SERVER-SIDE ONLY. Never expose it to the
# browser and never commit a real value.
GEMINI_API_KEY=""

# Optional. Override the default free-tier model (gemini-2.5-flash). Only set
# this to a model you've confirmed on the free tier in AI Studio.
# GEMINI_MODEL="gemini-2.5-flash"

# Optional. Age in milliseconds past which a stored campus water reading is
# treated as STALE by the assistant's deterministic paths. Default 3600000
# (1 hour). The server computes each reading's age (Date.now() vs its timestamp)
# and hands it to the model, which has no reliable clock of its own; lower this
# if your sensors report more frequently. Any non-positive/invalid value falls
# back to 1 hour.
# GEMINI_WATER_STALE_MS="3600000"

# FREE-TIER CAVEATS — read before enabling in production:
#  (i)  DATA USE: on the FREE (unpaid) tier, Google uses your prompts AND
#       responses to improve its products, and human reviewers may read them.
#       => Never send student PII here. For the student-data agent, use a PAID
#          Gemini key (excluded from training) with LLM_ALLOW_REMOTE_STUDENT_DATA
#          set, or keep local Gemma — see the resume-writer block above.
#  (ii) GROUNDING QUOTA: Google Search grounding is metered SEPARATELY from
#       ordinary requests (~1,500 grounded requests/day free on the 2.5 pool,
#       then billed). Both modes ground, so watch that meter independently.
#       Verify live limits at https://aistudio.google.com/rate-limit
# ---------------------------------------------------------------------------
