# REEP — the self-hosted deployment's environment.
#
#   cp .env.selfhost.example .env && $EDITOR .env
#   docker compose -f docker-compose.prod.yml up -d --build
#
# Docker Compose reads `.env` from the directory it runs in, and `.gitignore`
# ignores the whole `.env*` family while re-admitting `*.example` by name — so
# this file is committed and the one you fill in never is. Keep it that way:
# it will hold the key that signs every session cookie in the deployment.
#
# WHAT THIS DEPLOYMENT IS. Everything server-shaped runs on one machine the
# college owns: Postgres, the API, the compiled SPA behind nginx, the nightly
# logical dump, the retention sweep, the archive sweep. Two things stay in the
# cloud on purpose, because neither can run on that machine — the mock
# interviewer (Amazon Nova 2 Sonic on Bedrock) and the assistant's language
# model. docs/self-hosting.md is the runbook and carries the arithmetic; the
# short version is that of a $153/month AWS bill those two were $1.10.
#
# EVERY VARIABLE HERE REACHES THE CONTAINERS BY NAME. docker-compose.prod.yml
# enumerates its environment explicitly and has no blanket pass-through, so a
# name this file invents reaches nothing. If you need a setting that is not
# listed below, add it to the compose file as well — apps/api-py/.env.example
# documents the full surface, and most of it is deliberately not exposed here.


# ============================================================================
# 1. REQUIRED. The stack refuses to start without these four.
# ============================================================================

# The Postgres superuser the `db` service creates and every sidecar connects
# as. Not published to the host — only the compose network reaches 5432.
POSTGRES_USER=reep
# Generate, do not type:  openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME_database_password

# Host `db`, database `reep_py`, and it MUST agree with the two lines above.
# The `+psycopg` driver is forced by config.py either way; spelling it here
# keeps the URL readable.
DATABASE_URL=postgresql+psycopg://reep:CHANGE_ME_database_password@db:5432/reep_py

# THE ONE SECRET THAT IS NOT REPLACEABLE BY A PASSWORD RESET. It signs the
# HS256 `reep_session` cookie, so anyone holding it can mint a session for any
# account, the Main Admin included — no login, no database row. On ENV=prod
# the API REFUSES TO BOOT if this is blank, the value published in this repo,
# an obvious placeholder, or shorter than 32 characters, and the log names the
# problem. That refusal is deliberate and is not a bug in your deploy script.
#   python3 -c "import secrets;print(secrets.token_urlsafe(48))"
AUTH_SECRET=CHANGE_ME_run_the_command_above

# The origin students type, exactly: scheme, host, no trailing slash. It is
# the CORS origin and the cookie's scope. Wrong here and every login appears
# to succeed and then behaves as signed-out, which reads as a backend bug.
#
# https, NOT http. ENV=prod marks the session cookie Secure and a browser
# silently drops a Secure cookie over plain HTTP. Terminate TLS at the `web`
# service (uncomment its 443 mapping, the certificate mount and the 443 server
# block in apps/web/nginx.conf together) or in front of it.
WEB_ORIGIN=https://reep.your-college.ac.in


# ============================================================================
# 2. THE MOCK INTERVIEWER — the first of the two things that stay in the cloud.
# ============================================================================
#
# Amazon Nova 2 Sonic over Bedrock's bidirectional stream. THERE IS NO API KEY:
# the stream is signed with SigV4 from boto3's own credential chain. On AWS
# that chain found a task role and nothing was ever pasted; on this box it
# finds these.
#
# THE IAM USER BEHIND THESE SHOULD HOLD ONE ACTION. This machine is on a
# college network rather than inside a VPC, so a key here that can also read S3
# is a key that can read whatever the account holds:
#
#   bedrock:InvokeModelWithBidirectionalStream   on the Nova Sonic model
#   ses:SendEmail                                if section 5's mail is on
#   s3:PutObject, s3:ListBucket                  if section 6's archive is on
#
# Nothing else. In particular never s3:GetObject on a backup or archive bucket:
# that is read access to every document the college holds.
#
# Not using Bedrock at all is a supported state and NOT an outage: GET
# /api/interview/status reports the interviewer unavailable, the socket closes
# 4001, and every other screen works exactly as before — the mock interviewer,
# and only it, is off.
#
# BUT COMMENT THE LINES OUT RATHER THAN LEAVING THEM EMPTY. `FOO=` in this file
# sets FOO to the empty string inside the container, and unset and empty are
# different facts to boto3's credential chain: an empty access key is a
# half-supplied credential it reports as an error, where an absent one is a
# chain that cleanly finds nothing. The same holds for the region — an empty
# AWS_DEFAULT_REGION is a region of "", which is an invalid endpoint rather
# than a fallback. (docker-compose.prod.yml passes these as BARE NAMES for
# exactly this reason; a `#` here is what makes that work.)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# The region the Bedrock stream is opened in. Nova 2 Sonic is not in every
# region, which is why the interviewer has a region of its own — the reference
# deployment runs in ap-south-1 (Mumbai) and reaches Nova in ap-northeast-1
# (Tokyo). One of NOVA_SONIC_REGION / BEDROCK_REGION / AWS_REGION must resolve.
NOVA_SONIC_REGION=ap-northeast-1
# Everything else AWS (SES below, the document archive in section 6).
AWS_REGION=ap-south-1

# `nova` is the default and needs nothing here. `local` (app/interview_local.py)
# runs the interview on this machine instead and wants numpy and a model
# present — a different project, not a flag. An unrecognised value falls back to
# `nova` WITH A WARNING, because INTERVIEW_ENGINE=loca must not quietly leave
# the machine.
#INTERVIEW_ENGINE=nova

# Voice capture is OFF unless all three of these are true: this flag, the
# college's `interview_policies.store_audio`, and the student's own live
# scope_store_audio grant. The flag alone records nothing.
INTERVIEW_RECORDING_ENABLED=false


# ============================================================================
# 3. THE ASSISTANT — the second, and the cheaper of the two.
# ============================================================================
#
# Any OpenAI-compatible provider. Either name one explicitly here, or paste a
# single per-provider key below and let app/ai/llm.py auto-select the first it
# finds, in this order: Sakana, Groq, Mistral, OpenRouter, Gemini, Cohere.
# Several have a free tier that covers a college's volume, which is why this
# half of "the AI stays in the cloud" is a line item of roughly nothing.
#
#   Groq    LLM_BASE_URL=https://api.groq.com/openai/v1              LLM_MODEL=llama-3.3-70b-versatile
#   Gemini  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   LLM_MODEL=gemini-2.5-flash
#   Ollama  LLM_BASE_URL=http://host.docker.internal:11434/v1        LLM_MODEL=<your model>
#
# That last line is the escape hatch if the college later wants the assistant on
# the box too: a loopback model is the ONE case rule 1 lets student data reach
# without the flag below.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Or auto-select from one of these.
GROQ_API_KEY=
#MISTRAL_API_KEY=
#OPENROUTER_API_KEY=
#GEMINI_API_KEY=
#COHERE_API_KEY=

# RULE 1, AND THE ONLY LINE IN THIS FILE THAT DECIDES WHERE A STUDENT'S RECORD
# GOES. A resume brief carries a name, a USN, marks and attendance. Unset, the
# API refuses to send any of it to a model that is not on loopback, and
# /student/resume/generate composes the resume deterministically and says so on
# screen (used_ai=false) — a working feature, not an error. Only the exact
# string "true" opens that gate, and setting it means the provider above
# receives student records. The assistant and the Knowledge Base are unaffected
# either way; the KB is approved public policy text.
LLM_ALLOW_REMOTE_STUDENT_DATA=

# The KB's embedder. Blank leaves retrieval on Postgres full-text alone: hybrid
# search loses its vector half and answers get worse, but nothing breaks and
# the honest "no approved answer" fallback still works. The safest thing in
# this file to leave empty.
#EMBEDDING_BASE_URL=https://api.mistral.ai/v1
#EMBEDDING_MODEL=mistral-embed
#EMBEDDING_API_KEY=


# ============================================================================
# 4. SIGN-IN.
# ============================================================================
#
# Google for every role, with the roster as the access control: a verified
# Google account with no `users` row is refused and nothing self-provisions.
# Blank means the login screen draws the Google button disabled with the
# reason.
#
# THE AUTHORISED REDIRECT URI IN THE GOOGLE CONSOLE MUST NAME THIS ORIGIN.
# Moving the deployment and leaving the URI pointing at the old host is a
# sign-in that succeeds and then lands on a machine nobody is running.
# docs/google-sign-in.md has the exact string and a troubleshooting section.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://reep.your-college.ac.in/api/auth/sso/callback
GOOGLE_ALLOWED_DOMAIN=your-college.ac.in
# Where app.seed_roster derives a student's address from their USN
# (1MP25MDM01 -> 1mp25mdm01@<this domain>). Blank uses the first allowed domain
# above, so a single-domain college sets one variable.
#ROSTER_EMAIL_DOMAIN=your-college.ac.in

# THE PASSWORD DOOR IS DERIVED, NOT TOGGLED, so you almost certainly want to
# leave this blank. Open exactly when at least one account holds a real
# `scrypt:` hash — and since nothing self-issues one, issuing the first key
# with `python -m app.set_password <email>` IS the act of opening it. Set this
# to "false" only to force the door shut while keys are still in circulation.
#PASSWORD_LOGIN=


# ============================================================================
# 5. MAIL — the piece this move breaks most quietly.
# ============================================================================
#
# BLANK IS NOT "OFF", IT IS "THE CONSOLE": every message is logged in full and
# kept in a bounded in-memory outbox, and nothing leaves the box. That is right
# on a laptop and wrong on a deployment, because the onboarding setup link, the
# six-digit codes, a rejected applicant's reason and the delete-for-good second
# factor are all mail. Every one of them fails to the student as "I typed the
# right address and nothing came", which gets reported as a broken form.
#
# SES is what the code has, it authenticates with the AWS credentials already
# in section 2 (no second secret to store), and at a college's volume it costs
# cents — which is why it stayed when the rest of AWS went. The sender must be
# a VERIFIED SES identity, and a brand-new account is sandboxed until you ask
# for production access.
#
# The college's own SMTP relay instead is one function — app/mail_transport.py's
# `send()` — and docs/self-hosting.md carries that decision.
SES_FROM_ADDRESS=
#SES_REGION=
#SES_CONFIGURATION_SET=

# Both default false in config.py for the machine with no transport, where mail
# switched on writes a `mail_logs` row reading SENT about a message that
# reached nobody. Turn them on WITH the sender above, never before it. (SENT
# also means only that SES ACCEPTED it: an address on the account's suppression
# list receives nothing while the row still reads SENT.)
LEAVE_MAIL_ENABLED=false
BADGE_MAIL_ENABLED=false


# ============================================================================
# 6. DURABILITY — what is left after the AWS backup tiers go.
# ============================================================================
#
# Read docs/self-hosting.md's "What you are giving up" before deciding these
# are optional. The AWS deployment had automated RDS snapshots, a daily AWS
# Backup plan, a cross-region copy to Singapore and a monthly archive. This
# stack has the `db-backup` sidecar writing pg_dump -Fc into a Docker volume on
# THE SAME MACHINE as the database it protects — which answers "we dropped a
# table" and not "the machine died". Getting that volume off the box is the
# operator's job and nothing here does it for you.
#
# The document archive is the file half and it is the cheapest line item in
# this whole migration: S3 storage for a college's marksheets, certificates,
# resumes, signatures and recordings is cents a month, and it is the only copy
# that survives the machine. With this blank, `reep_uploads` is the only copy
# of every file, and a file a student deletes from the website is gone the
# moment the unlink returns.
#
# Versioning + Object Lock and NO lifecycle rule on the bucket, and the IAM
# user gets s3:PutObject and s3:ListBucket on it — never s3:GetObject. The
# sweep asks what already exists with list_objects_v2 for exactly that reason.
DOCUMENT_ARCHIVE_BUCKET=
#DOCUMENT_ARCHIVE_PREFIX=
#DOCUMENT_ARCHIVE_REGION=


# ============================================================================
# 7. SIZING AND VISIBILITY.
# ============================================================================

# Four uvicorn workers, each a full CPython process with the AI clients
# resident, against the api service's 2 CPU / 2G limit. A 4-core box that is
# also running Postgres wants 2. Every per-worker limit in config.py multiplies
# by this number.
#WEB_CONCURRENCY=4
# PER WORKER: 4 x 50 = 200 concurrent interviews across the fleet.
#INTERVIEW_MAX_SESSIONS=50

# Blank is OFF and says so once at boot. On a machine with nobody watching it
# and no CloudWatch behind it, a DSN is the only thing that will tell you the
# nightly dump has been failing for three weeks — and at this volume it is
# free. Two projects, deliberately: a nightly sweep filed under the API's
# issues is a job nobody watches.
SENTRY_DSN=
SENTRY_JOBS_DSN=

# libpq reads these directly. `prefer` is right for a Postgres on the compose
# network; set `require` or stricter only if the database moves off this box.
#PGSSLMODE=prefer
#PGSSLROOTCERT=
