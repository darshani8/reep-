# REEP voice worker — the LiveKit speech cascade, on Python 3.12.
#
# Why 3.12 and not the API's 3.14: livekit-agents declares
# `Requires-Python: <3.15,>=3.10`, a ceiling the API does not have, and 3.12 is
# the version this worker's SDK contract was actually verified against. Pinning
# it here means a future API bump to 3.15 cannot silently break the worker.
#
# Why NOT Alpine: livekit-plugins-silero depends on onnxruntime, which publishes
# no musl wheels at all. On Alpine the install either fails outright or falls
# back to a source build needing CMake and a C++ toolchain. glibc >= 2.28
# (bookworm) is required.

FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY requirements-voice.txt ./
# --only-binary=:all: so a missing wheel fails the BUILD loudly instead of
# quietly starting a twenty-minute source compile in CI.
RUN pip install --upgrade pip && \
    pip install --only-binary=:all: -r requirements-voice.txt

# The worker imports nothing from app/ — it is DB-free and talks to the API over
# HTTP — so only this one file is needed.
COPY voice_agent.py ./

RUN useradd --create-home --uid 10001 reep && chown -R reep:reep /app
USER reep

# No EXPOSE and no healthcheck port: the worker has no inbound HTTP surface. It
# dials out to LiveKit and is dispatched by name. Its liveness is observed
# indirectly, through the heartbeat row that GET /api/voice/status reads.

# `start`, NOT `dev`. The SDK only drains on SIGTERM when it is not in devmode
# (cli.py: `if not devmode: loop.run_until_complete(server.drain())`), so `dev`
# in production would kill live calls mid-sentence on every rolling deploy.
CMD ["python", "voice_agent.py", "start"]
