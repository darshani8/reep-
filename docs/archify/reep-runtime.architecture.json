        "focus": [
          "spa",
          "edge",
          "alb",
          "api",
          "db",
          "efs"
        ],
        "note": "Browser to CloudFront, WAF and ALB, into the FastAPI task, then Postgres and the EFS document store."
      },
      {
        "id": "mock-interview",
        "label": "Mock interview",
        "focus": [
          "spa",
          "edge",
          "alb",
          "api",
          "bedrock",
          "efs"
        ],
        "note": "The /api/interview WebSocket is relayed in-process to Nova 2 Sonic; no student record enters it."
      },
      {
        "id": "mail-sign-in",
        "label": "Mail and sign-in",
        "focus": [
          "spa",
          "api",
          "google",
          "ses",
          "db"
        ],
        "note": "Google ID tokens are verified against JWKS; mail goes out through SESv2 after a suppression check."
      },
      {
        "id": "egress-gate",
        "label": "Student-data egress gate",
        "focus": [
          "api",
          "gate",
          "bedrock"
        ],
        "note": "A prompt carrying a student's record reaches a remote model only through student_data_egress_allowed."
      },
      {
        "id": "nightly-protection",
        "label": "Nightly protection",
        "focus": [
          "jobs",
          "db",
          "efs",
          "archive"
        ],
        "note": "Scheduled tasks on the api image copy rows and files into Object-Locked S3 before the retention sweep."
      }
    ]
