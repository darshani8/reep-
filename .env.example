DATABASE_URL="postgresql://reep:reep_dev_password@localhost:5433/reep_dev?schema=public"
AUTH_SECRET="generate-a-long-random-string"

# --- Resume writer -----------------------------------------------------------
# Any OpenAI-compatible /v1/chat/completions server. Set both BASE_URL and MODEL
# to turn it on; leave either blank and the app falls back to Anthropic, then to
# the deterministic composer. This path is preferred when configured, because the
# prompt carries student PII and a local model keeps it on the machine.
#
# Local (default — run `npm run ai:setup` once to build the model):
LLM_BASE_URL="http://127.0.0.1:11434/v1"
LLM_MODEL="reep-gemma3"
LLM_API_KEY=""
# Must match the server's actual context window — see ollama/reep-gemma3.Modelfile.
LLM_CONTEXT_TOKENS="16384"
LLM_TIMEOUT_MS="300000"
#
# Other servers that speak the same protocol — swap the three values above:
#   LM Studio     LLM_BASE_URL="http://127.0.0.1:1234/v1"
#   vLLM          LLM_BASE_URL="http://your-host:8000/v1"
#   OpenRouter    LLM_BASE_URL="https://openrouter.ai/api/v1"          + a key
#   Groq          LLM_BASE_URL="https://api.groq.com/openai/v1"        + a key
#   Gemini        LLM_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
# Anything off this machine sends the student's record to a third party — and
# REEP now enforces that rather than only warning about it. If LLM_BASE_URL is
# not a loopback address, the resume writer refuses to send the student's name,
# USN, marks and attendance and composes the draft deterministically instead;
# the screen says so. Set this to exactly "true" to permit it anyway.
#
# This governs ANTHROPIC_API_KEY too. api.anthropic.com is not this machine, so
# the key on its own no longer turns the Anthropic path on: it names the
# recipient, it does not consent on the student's behalf. Without this flag a
# key-only setup gets the deterministic draft and the banner that explains why.
LLM_ALLOW_REMOTE_STUDENT_DATA=""

# Optional second path, used only when LLM_BASE_URL is unset — and, like any
# other off-machine writer, only when LLM_ALLOW_REMOTE_STUDENT_DATA is "true".
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

COURSERA_CLIENT_ID=""
COURSERA_CLIENT_SECRET=""
