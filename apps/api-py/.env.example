# FastAPI backend (fresh Python schema). Copy to apps/api-py/.env and fill in.
#
# A SEPARATE database from the Next.js/Prisma app during the migration, so the
# fresh SQLAlchemy schema does not collide with the existing Prisma tables in
# the same Postgres server. Create it once the DB is up:
#   docker exec reep-postgres createdb -U reep reep_py
#
# THE PASSWORD BELOW IS PUBLISHED IN THIS REPOSITORY. A production process
# (ENV=prod) whose DATABASE_URL still contains `reep_dev_password` REFUSES TO
# BOOT, and says so — see app/config.py:production_boot_failures. Either the
# whole default is untouched, in which case production is about to serve a
# developer's laptop database, or a real host is carrying a credential everyone
# who cloned REEP knows. Change the password, then this line.
DATABASE_URL="postgresql+psycopg://reep:reep_dev_password@localhost:5433/reep_py"
# SQLAlchemy pool per process: up to POOL_SIZE + MAX_OVERFLOW connections, and a
# request that cannot get one within POOL_TIMEOUT_S fails rather than queueing
# into a 30-second wall. Size workers x (size + overflow) UNDER Postgres
# max_connections — docker-compose.prod.yml carries the arithmetic. The defaults
# fit a single dev process; blank lines fall back to them.
#DB_POOL_SIZE="20"
#DB_MAX_OVERFLOW="20"
#DB_POOL_TIMEOUT_S="5"

# The HS256 key for the `reep_session` cookie, and the key the OAuth flow cookie
# is derived from. Whoever knows it IS every user: a forged {"role":"DIRECTOR"}
# claim reads every student's marks, attendance and USN with no login involved.
#
# THE VALUE BELOW IS PUBLISHED IN THIS REPOSITORY, so with ENV=prod the API
# REFUSES TO BOOT on it — and equally on a blank one, on anything still carrying
# "change-me", and on anything shorter than 32 characters (HS256 signs with these
# bytes; a key shorter than its 32-byte digest is brute-forceable offline from
# one captured cookie). Generate a real one:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Changing it signs every live session out, which is the correct trade.
AUTH_SECRET="reep-dev-secret-change-me-in-production-0123456789abcdef"

# Angular dev origin, for CORS (credentials are allowed, so this cannot be "*").
WEB_ORIGIN="http://localhost:4200"

# WHICH ENVIRONMENT THIS IS — and it is read as an ALLOWLIST in both directions,
# not as a boolean. "prod"/"production"/"prd"/"live" mean production: the boot
# guards above apply and /docs is hidden. "dev"/"development"/"test"/"testing"/
# "ci"/"local" are the only names that keep the development affordances —
# password sign-in at POST /api/auth/login, a session cookie without `Secure`,
# and an unauthenticated voice worker when VOICE_WORKER_SECRET is blank.
#
# ANYTHING ELSE — "staging", "uat", "demo", a typo, or an empty value from a
# half-written deploy template — is treated as production-like and LOSES all
# three. That is deliberate: those boxes hold real roster rows on real HTTPS, and
# the failure of a misconfiguration here must be "nobody can sign in with a
# password", never "the session cookie went over the wire in the clear".
ENV="dev"

# Whether /docs, /redoc and /openapi.json are served. Default: yes in dev, NO in
# production unless this line is present and true — the endpoints stay
# authenticated either way, but an open schema is the map: every route, every
# field name, every enum value, staff-only surfaces included. A BLANK value
# counts as unset (i.e. still hidden in prod), so a stray empty line here cannot
# republish the surface.
#DOCS_ENABLED="true"

# Sessions are stateless 12-hour JWTs, so signing out cannot invalidate a token
# somebody already copied; a server-side revocation list closes that, and this is
# how long one decision is cached in-process — the window in which a logged-out
# token still works. 0 means ask the database on every request.
#AUTH_REVOCATION_CACHE_SECONDS="60"

# --- Google sign-in (one of the two ways in) ---------------------------------
# Every role — student, mentor, director — signs in with a Google account, and
# the ROSTER is the access control: a Google account with no row in `users` is
# refused. These two only tell us who Google says the visitor is.
#
# Get them at https://console.cloud.google.com -> APIs & Services ->
# Credentials -> Create credentials -> OAuth client ID -> "Web application".
# The secret is server-side only: it is used on the token exchange and never
# reaches the browser. BLANK IS OFF — the login screen disables the Google
# button and says it is not configured, rather than bouncing a student to a
# Google error page. (Email & password sign-in is the OTHER door - see the
# LOCAL_AUTH_ENABLED block below; without it, production refuses passwords.)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OPTIONAL — leave blank unless the public URL is not WEB_ORIGIN (a proxy in
# front, a separate API host). Blank derives WEB_ORIGIN + the callback route
# (app/google_auth.py:CALLBACK_PATH), i.e. in dev exactly:
#   http://localhost:4200/api/auth/sso/google/callback
# and THAT is the string to paste into the console's "Authorised redirect URIs".
# It must be byte-identical there, and it must be the origin the BROWSER is on:
# do NOT point it at :3300, because the dev proxy rewrites the Host header and
# the API's own view of its URL is not where the student is.
GOOGLE_REDIRECT_URI=""

# The college's mail domain(s), comma-separated (student domain FIRST). This is
# NOT the access control and is not enforced at sign-in: the roster is the
# allowlist, and app/google_auth.py explains why a domain test on top of it
# could only add a second way to lock out an enrolled student. It is here so one
# line states which domain is ours, so ROSTER_EMAIL_DOMAIN can default to it, and
# so GET /api/auth/sso/status can tell the login screen which domain to name in
# its "use your college account, the one ending @..." copy.
GOOGLE_ALLOWED_DOMAIN="bgscet.ac.in"

# How a USN becomes an email: 1MP25MDM01 -> 1mp25mdm01@bgscet.ac.in (the USN,
# lowercased, as the local part). Used by `python -m app.seed_roster` to write
# the roster, and it is therefore the address the student must sign in with.
# This is the one line here that is a GUESS about the outside world: if the real
# convention differs by a single character, every student is locked out — so it
# is a variable, and the fix is a .env edit rather than a code change and a
# redeploy. COLLEGE_EMAIL_DOMAIN is accepted as an alias (the name
# `seed_roster --help` prints). Blank -> the first GOOGLE_ALLOWED_DOMAIN entry.
# If it turns out wrong AFTER a batch is seeded, correct it here and re-run with
# `python -m app.seed_roster --rekey-domain <the old one>` — without that flag
# every USN is already taken and the re-run writes nothing at all.
ROSTER_EMAIL_DOMAIN=""

# --- Outbound email (app/email.py) --------------------------------------------
# Which transport sends mail. "ses" (AWS SESv2, signed by the task role - no key),
# "smtp" (any relay, stdlib smtplib; port 465 = implicit TLS, otherwise STARTTLS),
# "log" (dev/CI: the message is written to the API log and NEVER sent - and
# because a sign-in code in a log is a sign-in code, "log" is refused as a
# transport on every non-dev ENV). Blank is off - except on a dev ENV, where
# blank means "log" so the password flow works on a fresh clone.
#   Google Workspace relay:  EMAIL_TRANSPORT=smtp SMTP_HOST=smtp-relay.gmail.com SMTP_PORT=587 SMTP_STARTTLS=true
#   Mailpit / MailHog:       EMAIL_TRANSPORT=smtp SMTP_HOST=localhost SMTP_PORT=1025 SMTP_STARTTLS=false
# A username without TLS (STARTTLS off and port not 465) is refused as "ready":
# credentials must not go over the wire in the clear.
#EMAIL_TRANSPORT=""
#EMAIL_FROM="REEP <no-reply@bgscet.ac.in>"
#EMAIL_REPLY_TO=""
#SES_REGION=""
#SES_CONFIGURATION_SET=""
#SMTP_HOST=""
#SMTP_PORT="587"
#SMTP_USERNAME=""
#SMTP_PASSWORD=""
#SMTP_STARTTLS="true"

# --- Email & password sign-in (app/local_auth.py) ------------------------------
# The second door beside Google, for addresses ALREADY on the roster and on
# ROSTER_EMAIL_DOMAIN. Setting, resetting or changing a password needs a code
# emailed to that address, so this needs a working transport above;
# GET /api/auth/sso/status says whether it is ready and why not. Off by
# default; when off, nothing here changes and production keeps refusing
# POST /api/auth/login. Normal sign-in is email + password with no code; the
# code is only for creating, resetting or changing the password.
#LOCAL_AUTH_ENABLED="false"

# --- Universal LLM (app/ai/llm.py) -------------------------------------------
# Any OpenAI-compatible provider — paste your key into LLM_API_KEY and set the
# base URL + model. Examples:
#   Gemini (free)   LLM_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"  LLM_MODEL="gemini-2.5-flash"
#   Groq (free)     LLM_BASE_URL="https://api.groq.com/openai/v1"          LLM_MODEL="llama-3.3-70b-versatile"
#   Cerebras (free) LLM_BASE_URL="https://api.cerebras.ai/v1"             LLM_MODEL="llama-3.3-70b"
#   Local (Ollama)  LLM_BASE_URL="http://127.0.0.1:11434/v1"             LLM_MODEL="reep-gemma3"
LLM_BASE_URL=""
LLM_MODEL=""
LLM_API_KEY=""
# Was 300000 (5 min). Every LLM call occupies a worker thread for its whole
# life, and 60 s is already generous for a resume brief — a provider that has
# not answered in a minute is not going to, and the deterministic fallback
# exists for exactly that day. Raise only for a deliberately slow local model.
LLM_TIMEOUT_MS="60000"
# Per-user, per-minute cap on the LLM-backed HTTP routes (resume generation and
# the /api/agent chat surface): invisible to a human clicking a button, a wall
# to a retry loop. Per worker process, so N workers relax it to at most N x
# this. 429 with Retry-After when hit.
#LLM_REQUESTS_PER_MINUTE="5"

# Or drop in a per-provider key and the adapter auto-selects (order: Sakana,
# Groq, Mistral, OpenRouter, Gemini, Cohere) — no LLM_BASE_URL/MODEL needed.
# SAKANA_API_KEY is checked first; Sakana Fugu is itself a multi-model router
# (https://console.sakana.ai) speaking the OpenAI protocol at api.sakana.ai/v1
# (models: fugu, fugu-ultra, fugu-cyber).
SAKANA_API_KEY=""
GROQ_API_KEY=""
MISTRAL_API_KEY=""
OPENROUTER_API_KEY=""
GEMINI_API_KEY=""
COHERE_API_KEY=""

# Egress gate. A remote (non-loopback) model will NOT receive student data —
# marks, USN, attendance — unless this is exactly "true". Free tiers train on
# submissions, so for the student-data agents use a local model or a PAID key;
# leave this blank for free keys and use them only for general/public prompts.
LLM_ALLOW_REMOTE_STUDENT_DATA=""

# --- Voice assistant (LiveKit + Groq speech cascade) -------------------------
# Voice is a CASCADE, not native speech-to-speech:
#   BVC noise cancellation -> Silero VAD -> Groq Whisper -> Groq Llama -> TTS
# (Gemini Live was the original design; that path is dead — see voice_agent.py.)
#
# You need TWO things:
#   1. A free LiveKit Cloud project (https://cloud.livekit.io) for these three.
#      LIVEKIT_URL is the project's wss:// URL. Copy the secret with the console's
#      copy button — selecting the masked value copies bullet characters.
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
#   2. GROQ_API_KEY above — one key drives STT, the LLM and (optionally) TTS.
#      GEMINI_API_KEY is NOT used by voice.
# /api/voice/token returns 503 until the three LIVEKIT_* are set, and 409 while
# no voice worker is heartbeating. The worker (voice_agent.py) runs as a
# SEPARATE process in its own venv — see requirements-voice.txt.

# Which voice to speak with.
#   edge = default. Unofficial Microsoft endpoint: no key, no quota, NO SLA and
#          no privacy terms. Fine for development; do NOT ship it to students.
#   groq = officially supported plugin on the same GROQ_API_KEY, but the free
#          tier allows only 10 requests/minute and 100/DAY for the whole org —
#          about 5-10 conversations a day in total. Requires a one-off terms
#          acceptance for the model at console.groq.com.
# Production should use an SLA-backed TTS rather than either of these.
#
# THE DEFAULT IS NOW "groq" (voice_agent.py) and this line no longer sets edge.
# It used to, uncommented, which meant every fresh checkout and every demo spoke
# through the unofficial endpoint described above -- a default is what runs, so
# a warning printed next to a dangerous default is only a record of the decision
# nobody made. Uncomment it to opt IN to edge for local development; the worker
# logs a loud warning every time it is selected.
#VOICE_TTS="groq"

# Shared secret the worker presents as X-Voice-Worker-Secret on
# POST /api/voice/heartbeat and /api/voice/transcript.
# BLANK IS OPEN: anyone who can reach the API could forge a heartbeat (voice then
# reports itself available with no worker behind it) or write assistant-labelled
# turns into a conversation. Tolerated ONLY on the dev ENV names listed above —
# on anything else, including "staging" and a blank ENV, a blank secret makes
# those endpoints return 500 rather than accept anonymous writes, and the API
# warns about it at startup.
VOICE_WORKER_SECRET=""

# Non-empty forces voice unavailable and shows this text to students (incidents).
# This is the kill switch: it overrides a perfectly healthy provider and worker.
VOICE_MAINTENANCE_MESSAGE=""

# How many voice sessions ONE student may hold at once. Tokens used to be minted
# without limit, one fresh room each, so a single scripted account could exhaust
# worker memory and Groq spend. 2 lets a student whose browser died start again
# without waiting out the old room.
#VOICE_MAX_SESSIONS_PER_USER="2"
# ...and how long one call may run. The token TTL bounds only how long a student
# has to JOIN, never the call itself. Matched to INTERVIEW_MAX_SECONDS so the
# rollback path cannot be the cheaper way to a longer session.
#VOICE_MAX_CALL_SECONDS="900"

# --- Realtime mock interview (app/routers/interview.py) ---------------------
# The student-facing assistant on /student/assistant: the API relays the
# browser's microphone to a speech-to-speech model and back, inside this
# process. WHICH model is INTERVIEW_ENGINE, immediately below.
#
# ---- WHICH ENGINE RUNS THE INTERVIEW --------------------------------------
# "nova" (default)    app/interview_nova.py -> Amazon Nova 2 Sonic on Bedrock,
#                     over InvokeModelWithBidirectionalStream. NO API KEY: the
#                     stream is signed with SigV4 from the standard AWS chain
#                     (task role, instance profile, profile, environment), so an
#                     AWS-hosted REEP grants the role
#                     bedrock:InvokeModelWithBidirectionalStream and pastes
#                     nothing. Rule 1 is unchanged — Bedrock is off-machine, and
#                     no student record enters the session.
#
#                     NO RESOLVABLE REGION IS OFF, and only for this feature:
#                     GET /api/interview/status reports unavailable with a
#                     reason, and the WebSocket closes 4001.
# "local"             app/interview_local.py -> nothing leaves the machine
#                     (faster-whisper + Ollama + Piper). Needs the fourth venv.
# A THIRD ENGINE, "openai", relayed this interview to api.openai.com until
# 2026-09. It is gone, and "openai" is no longer a recognised value.
#
# An unrecognised value falls back to the default WITH A WARNING rather than
# being guessed at: INTERVIEW_ENGINE=loca must not quietly leave the machine.
#INTERVIEW_ENGINE="nova"

# Nova 2 Sonic, and only read when INTERVIEW_ENGINE="nova".
# The MODEL ID, not an inference profile: the bidirectional API takes the bare
# id and rejects a regional prefix, which is why this is separate from
# BEDROCK_MODEL.
#NOVA_SONIC_MODEL="amazon.nova-2-sonic-v1:0"
# The region the stream is opened in. Blank falls back to BEDROCK_REGION and
# then to AWS_REGION / AWS_DEFAULT_REGION. It must resolve to something: the
# endpoint is composed from it here, so blank is "not configured" (the status
# probe says so) rather than "let the SDK decide".
#NOVA_SONIC_REGION=""
# The GENERIC track's voice; a picked specialization speaks with its matrix
# row's voice instead (HR kiara, DM tiffany, BA arjun, FA matthew). Nova's names
# are NOT OpenAI's — matthew, tiffany, amy, olivia, lupe, carlos, ambre,
# florian, lennart, beatrice, lorenzo, tina, carolina, leo, kiara, arjun — and
# an unknown one is logged and falls back to "matthew" rather than failing the
# handshake, which is where Nova rejects a bad voiceId.
#NOVA_SONIC_VOICE="matthew"
# HIGH | MEDIUM | LOW: how fast Nova decides the student has stopped speaking.
# MEDIUM on purpose — an interview answer contains thinking pauses, and HIGH
# reads them as the end of the turn.
#NOVA_SONIC_ENDPOINTING="MEDIUM"
# The uplink rate. The browser captures 24 kHz and the engine resamples; Nova
# accepts 8000/16000/24000 and 16000 is the documented path.
#NOVA_SONIC_INPUT_RATE_HZ="16000"
# Bedrock closes a bidirectional stream after 8 minutes, which is SHORTER than
# INTERVIEW_MAX_SECONDS below. The Nova engine therefore treats this (minus a
# margin) as the real cap, reports it to the client's countdown, and forces the
# wrap-up early enough for the verdict and the scorecard to finish inside it.
#NOVA_SONIC_CONNECTION_SECONDS="480"

# Hard cap on one interview — a cost ceiling as much as a product decision:
# audio tokens bill per second of a session a forgotten tab would hold open.
#INTERVIEW_MAX_SECONDS="900"
# No inbound audio at all for this long means the student left or the mic died.
#INTERVIEW_IDLE_SECONDS="120"
# PER-WORKER concurrency cap; N uvicorn workers give N times this.
#INTERVIEW_MAX_SESSIONS="100"
# ...and the per-STUDENT cap, which is the one that matters for cost: the line
# above counts sessions without asking whose they are, so one account looping
# `new WebSocket('/api/interview')` could hold every slot — and each of those
# sockets bills from the handshake with no microphone input at all.
#INTERVIEW_MAX_SESSIONS_PER_USER="2"
# ...and the VOLUME half of that cap: how many interviews one student may START
# in any rolling 24 h, counted over interview_sessions (abandoned and failed
# included — each one billed an upstream handshake). Refused with close 4015
# before anything is written or billed. 8 is a full afternoon of honest
# practice; a student hitting it is looping, sharing a cookie, or scripted.
#INTERVIEW_MAX_PER_STUDENT_PER_DAY="8"
# The answer gate — a word count, not a model call, because this runs between the
# student finishing and the interviewer replying. Below this, the transcript is
# not an answer: it is recorded as `too_short` and does not advance the arc.
# 4 clears "yes", "I don't know" and a cough transcribed as "uh". 0 disables it.
#INTERVIEW_MIN_ANSWER_WORDS="4"
# Budget for the final scorecard, asked for once the spoken verdict is done. On expiry the evaluation records that the report was
# unavailable and the session still closes cleanly — a missing report must never
# cost the transcript.
#INTERVIEW_REPORT_TIMEOUT_MS="20000"
# Audio capture of interviews. OFF, and it needs more than this flag: recorded
# consent from the student (see INTERVIEW_CONSENT_VERSION), a retention deadline,
# and DIRECTOR/ADMIN-only retrieval. Turning it on without the consent record in
# place is the mistake that cannot be undone afterwards.
#INTERVIEW_RECORDING_ENABLED="false"
# Hard per-session ceiling on stored audio — a disk-exhaustion stop, not a
# quality setting. Both speakers are recorded to their own wall-clock-padded
# track, so an interview burns 96,000 B/s regardless of who is talking: 128 MB
# is ~22 minutes, comfortably past INTERVIEW_MAX_SECONDS (900). Budget ~256 MB
# of disk per session — the derived `mixed` copy is written on top. At the cap
# the recording stops, audio_truncated is set, and the interview continues.
#INTERVIEW_RECORDING_MAX_BYTES="128000000"
# Where the WAVs live. Blank = a SIBLING of the uploads dir named
# interview-audio. Set it explicitly in production to a MOUNTED path —
# docker-compose.prod.yml mounts a dedicated volume and sets this — because the
# sibling fallback inside a container is the writable layer, and recordings
# there are silently destroyed on every redeploy.
#INTERVIEW_AUDIO_DIR=""
# Free-disk floor below which NEW recordings are declined (the interview itself
# proceeds, and in-flight recordings keep flushing). Capture burns 96,000 B/s
# per session, and a full disk takes down uploads and a co-located Postgres —
# a far worse trade than one interview going unrecorded.
#INTERVIEW_AUDIO_MIN_FREE_BYTES="2000000000"
# How long an interview record — transcript, evaluation, any audio — is kept
# before the reaper deletes it. 180 days covers a placement season and its
# review. There is no "keep forever" value, and 0 is refused at startup because
# its two honest readings differ by the entire record.
#INTERVIEW_RETENTION_DAYS="180"
# How long an interview may sit marked `running` with no heartbeat before the
# sweeper records it as abandoned. A killed worker cannot finalize its own
# sessions, so without this every crash leaves rows that claim to be live
# forever. 1200 = INTERVIEW_MAX_SECONDS + 300, i.e. comfortably past the longest
# legal interview so a healthy one is never swept.
#INTERVIEW_ORPHAN_GRACE_SECONDS="1200"
# Stamped on every consent row, so a change of terms shows up in the data instead
# of being assumed. Consent is not retroactive: bump this when what the student
# agrees to changes, and older rows stop counting as consent for the new terms.
# 2026-09 is the Bedrock wording; 2026-08 named OpenAI, which no longer receives
# anything, so grants carrying it are deliberately no longer honoured.
#INTERVIEW_CONSENT_VERSION="2026-09"

# --- read by voice_agent.py ONLY (the worker process), not by the API --------
# Where the worker POSTs heartbeats and transcripts. The default is right when
# both run on one machine; in containers it MUST be the API's service name, as
# the worker's own loopback has nothing listening.
#REEP_API_URL="http://localhost:3300"
# Identifies this worker in the heartbeat table. Defaults to a fresh random id
# per process, which is fine — the table is reaped.
#VOICE_WORKER_ID=""
# The REPLY brain only, swappable to any OpenAI-compatible endpoint — in
# practice a local Ollama, which keeps the student's spoken words from reaching
# Groq's LLM (their AUDIO still goes to Groq twice: speech-to-text and
# text-to-speech — the two stages Ollama cannot serve). BOTH must be set or the
# worker warns and stays on Groq; the API key may stay unset (Ollama ignores
# it). Know the trade: a local 12B model answers seconds slower than Groq,
# and in a spoken conversation that pause is audible.
#VOICE_LLM_BASE_URL="http://127.0.0.1:11434/v1"
#VOICE_LLM_MODEL="reep-gemma3"
#VOICE_LLM_API_KEY=""
#
# Do NOT set LIVEKIT_AGENT_NAME or similar. The dispatch name is compile-time on
# both sides (VOICE_AGENT_NAME in app/routers/voice.py, matched by the worker's
# registration and pinned by a test). Making it an env var invites the two to
# disagree, and that failure is silent: the token mints, the room opens, the
# microphone publishes, and no agent ever joins.
