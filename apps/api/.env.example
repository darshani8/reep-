# apps/api — NestJS backend for the REEP Angular migration.
# Copy to apps/api/.env (gitignored) and fill in.

# Shares the Next.js app's database and auth secret during the migration, so a
# session minted here verifies there and both read the same seeded roster.
DATABASE_URL="postgresql://reep:reep_dev_password@localhost:5433/reep_dev?schema=public"
AUTH_SECRET="reep-dev-secret-change-me-in-production-0123456789abcdef"
PORT=3200
WEB_ORIGIN="http://localhost:4200"

# --- SSO (roadmap Phase A) ---------------------------------------------------
# Google OAuth. Create a client at https://console.cloud.google.com/apis/credentials
# (OAuth client ID, type "Web application"), and add this exact redirect URI:
#   http://localhost:4200/api/auth/sso/google/callback   (dev — same-origin via the web proxy)
# In production use your served origin, e.g. https://reep.bgscet.ac.in/api/auth/sso/google/callback
#
# Until both are set, the "Sign in with Google" button answers 503 "not
# configured" — the app ships and runs without it. SSO signs in EXISTING
# accounts only (matched by verified email); it never registers a new one.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional — defaults to WEB_ORIGIN + /api/auth/sso/google/callback.
GOOGLE_REDIRECT_URI=""
